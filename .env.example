# Optional. Leave unset when the backend serves this build statically (same
# origin) — the app falls back to the relative path /api/v1. In `npm run dev`
# requests to /api are proxied to the backend, so this is only needed when the
# backend lives on a different origin.
# VITE_SERVER_URL=https://api.example.com/api/v1

# Backend origin that `npm run dev` proxies /api to. Defaults to http://localhost:3000
# BACKEND_URL=http://localhost:3000
